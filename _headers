# Cloudflare Pages response headers.
#
# /assets holds the stylesheet, the event script, the favicon and the social
# image. Without this file Pages serves them with max-age=0, so every visit
# revalidates them, which PageSpeed flags. A day of fresh cache plus a week of
# stale-while-revalidate keeps repeat visits fast while still letting a change
# to kys.css reach everyone within a day, with no version query strings to
# maintain. Added 2026, after the September spam update freeze.
#
# Since 2026-10-15 the pages carry kys.css inline (scripts/inline_css.py) and
# no longer request it. The file is still served here for anything that still
# links it, such as a page cached before the change.

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Self-hosted fonts never change under the same file name, so cache them for a
# year. Rename the file if a font is ever replaced.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Calculators may be embedded on other sites (?embed=1, see /embed and
# scripts/build_embeds.py), so tool pages carry no framing restriction. The
# pages that sell, unlock or deliver a paid pack are never framed by anyone
# else: that keeps a lookalike page from overlaying the checkout or the pack.
/bc/starter-pack*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/on/starter-pack*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/api/*
  X-Frame-Options: DENY
